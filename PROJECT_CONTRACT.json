{
  "schema_version": "1.12.0",
  "repository": "SupraCraft/Bridge",
  "upstream_repository": "ME1312/Bridge",
  "role": "post-compile Maven transformation system and bytecode support library",
  "source_version": "0.1.1-dev",
  "brand": {
    "organization": "SupraCraft",
    "contract_version": "0.1.0-candidate",
    "profile": "BRAND_PROFILE.json",
    "governance_source": "SupraCraft/brand-governance-private:profiles/projects/Bridge.json",
    "runtime_dependency_on_private_repo": false
  },
  "artifact": {
    "group": "io.github.supracraft.bridge",
    "parent": "bridge-parent",
    "modules": ["bridge", "bridge-asm", "bridge-plugin", "bridge-test"],
    "optional_modules": ["bridge-mc-it"],
    "standalone": [
      "supracraft-bridge-<version>.jar",
      "supracraft-bridge-asm-<version>.jar",
      "supracraft-bridge-plugin-<version>.jar",
      "supracraft-bridge-sbom-<version>.json"
    ],
    "embedded_project_icon": "bridge:META-INF/supracraft/bridge/icon.svg"
  },
  "versioning": {
    "development_source": "X.Y.Z-dev",
    "development_ci": "X.Y.Z-dev.<github-run-number>",
    "release_candidate": "X.Y.Z-rc.N",
    "release_candidate_branch": "release/X.Y.Z-rc.N",
    "release_candidate_manifest": "RELEASE_CANDIDATE.json",
    "release_candidate_publication": "github-packages-after-qualified-tested-build",
    "release": "X.Y.Z",
    "stable_release_branch": "stable/X.Y.Z",
    "stable_release_manifest": "STABLE_RELEASE.json",
    "stable_release_publication": "github-packages-and-github-release-after-qualified-tested-build",
    "release_tag": "vX.Y.Z",
    "maven_snapshot_semantics": false
  },
  "toolchain": {
    "maven_wrapper": "3.3.4",
    "maven": "3.9.16",
    "java_bytecode_release": 21,
    "asm": "9.10.1",
    "asm_single_version_required": true
  },
  "compatibility": {
    "contract": "COMPATIBILITY.json",
    "host_workflow": ".github/workflows/compatibility.yml",
    "classfile_workflow": ".github/workflows/classfile-compatibility.yml",
    "modern_bytecode_workflow": ".github/workflows/modern-bytecode-compatibility.yml",
    "release_qualification_workflow": ".github/workflows/release-qualification.yml",
    "support_claims_require_evidence": true,
    "one_bridge_build_per_bridge_version": true
  },
  "validation": {
    "build": "./mvnw -B verify",
    "reproducibility": "scripts/verify-reproducible-build.sh",
    "deploy_tested_artifacts": "scripts/deploy-tested-artifacts.sh",
    "stage_standalone_artifacts": "scripts/stage-standalone-artifacts.sh",
    "documentation_contract": "scripts/check-documentation-contract.sh",
    "public_site_builder": "scripts/build-public-site.py",
    "public_site_check": "scripts/check-public-site.py",
    "public_site_readiness_workflow": ".github/workflows/public-site-readiness.yml",
    "public_site_readiness_reusable_workflow": "SupraShellScripts/github-ops-lab/.github/workflows/public-site-readiness.yml@a81cede6ae6c8d460c2922aa35103137633abddc",
    "public_site_playwright_config": "playwright.config.mjs",
    "public_site_browser_test": "tests/site/public-site.spec.mjs",
    "public_site_accessibility_engine": "@axe-core/playwright",
    "public_site_lighthouse_config": "lighthouserc.cjs",
    "public_site_link_checker": "lycheeverse/lychee-action",
    "browser_projects": [
      "desktop-chromium",
      "desktop-firefox",
      "desktop-webkit",
      "android-chromium",
      "iphone-webkit"
    ],
    "accessibility_target": "WCAG 2.2 AA",
    "compatibility_workflow": ".github/workflows/compatibility.yml",
    "classfile_compatibility_workflow": ".github/workflows/classfile-compatibility.yml",
    "classfile_compatibility_runner": "scripts/run-classfile-compatibility.sh",
    "modern_bytecode_compatibility_workflow": ".github/workflows/modern-bytecode-compatibility.yml",
    "modern_bytecode_compatibility_runner": "scripts/run-modern-bytecode-compatibility.sh",
    "release_qualification_workflow": ".github/workflows/release-qualification.yml",
    "release_qualification_aggregator": "scripts/aggregate-release-qualification.py",
    "release_context_resolver": "scripts/resolve-release-context.py",
    "release_candidate_validator": "scripts/validate-release-candidate.py",
    "stable_release_validator": "scripts/validate-stable-release.py",
    "release_coordinate_absence_check": "scripts/assert-maven-version-absent.sh",
    "release_coordinate_presence_check": "scripts/assert-maven-version-present.sh",
    "run_report_validator": "scripts/check-run-report.py",
    "publication_model": "build-once-promote-tested-bytes"
  },
  "diagnostics": {
    "human_transport": "maven-log",
    "stable_diagnostic_ids": true,
    "event_catalog": "docs/diagnostics.md",
    "authoritative_failure_signal": "maven-process-exit-code",
    "structured_run_report": {
      "enabled_by_default": true,
      "default_path": "${project.build.directory}/bridge/bridge-report.json",
      "schema_id": "bridge-run/1",
      "schema": "schemas/bridge-run-report.schema.json",
      "validator": "scripts/check-run-report.py",
      "artifact_identity": false,
      "contains_absolute_environment_paths": false
    }
  },
  "retention": {
    "actions_build_evidence_days": 14,
    "actions_publication_handoff_days": 1,
    "release_assets": "durable-historical-provenance",
    "release_qualification_evidence_days": 90,
    "release_candidate_evidence_days": 90,
    "stable_release_evidence_days": 90,
    "maven_dev_package_cleanup": "reference-gated-and-deferred-until-stable-release-line"
  },
  "public_surface": {
    "github_metadata": "GITHUB_METADATA.json",
    "metadata_apply": "scripts/apply-github-metadata.py",
    "pages_entrypoint": "docs/index.html",
    "pages_url": "https://supracraft.github.io/Bridge/",
    "pages_source": "github-actions",
    "pages_workflow": ".github/workflows/pages.yml",
    "site_builder": "scripts/build-public-site.py",
    "brand_profile": "BRAND_PROFILE.json",
    "brand_manifest": "docs/assets/brand/brand.json",
    "brand_guidelines": "docs/brand-guidelines.md",
    "readiness_policy": "docs/PUBLIC_SITE_RELEASE_READINESS.md",
    "human_routes": {
      "use": "use/",
      "compatibility": "compatibility/",
      "releases": "releases/",
      "release_info": "releases/<version>/",
      "accessibility": "accessibility/"
    },
    "machine_endpoints": ["project.json", "compatibility.json", "github.json", "brand.json", "artifacts.json", "llms.txt"],
    "upstream_attribution_required": true
  },
  "provenance": {
    "source_repository": "SupraCraft/Bridge",
    "upstream_repository": "ME1312/Bridge",
    "records_git_commit_ref_run": true,
    "fixed_archive_output_timestamp": true,
    "published_maven_bytes_are_tested_bytes": true,
    "release_qualification_binds_source_sha": true,
    "release_qualification_binds_bridge_version": true,
    "release_candidate_coordinates_immutable": true,
    "release_candidate_publish_rebuilds": false,
    "stable_release_coordinates_immutable": true,
    "stable_release_publish_rebuilds": false,
    "stable_release_requires_qualified_candidate": true,
    "stable_tag_source_version_matches_coordinate": true
  },
  "documentation": {
    "human_entrypoint": "README.md",
    "agent_instructions": "AGENTS.md",
    "policy": "docs/DOCUMENTATION_POLICY.md",
    "artifact_identity": "ARTIFACT_IDENTITY.md",
    "versioning": "VERSIONING.md",
    "artifact_consumption": "docs/artifact-consumption.md",
    "diagnostics": "docs/diagnostics.md",
    "artifact_retention": "docs/artifact-retention.md",
    "compatibility": "COMPATIBILITY.json",
    "release_candidates": "docs/release-candidates.md",
    "uplift_roadmap": "docs/roadmap/0.1.0-uplift.md",
    "github_metadata": "GITHUB_METADATA.json",
    "brand_profile": "BRAND_PROFILE.json",
    "pages_entrypoint": "docs/index.html",
    "brand_guidelines": "docs/brand-guidelines.md",
    "public_site_release_readiness": "docs/PUBLIC_SITE_RELEASE_READINESS.md",
    "run_report_schema": "schemas/bridge-run-report.schema.json"
  }
}
